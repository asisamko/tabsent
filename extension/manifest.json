{
  "manifest_version": 3,
  "name": "Window Focus Bypass",
  "short_name": "Focus Bypass",
  "version": "1.0.0",
  "description": "Stop websites from noticing that you switched to another window or tab. Switch it on per site from the toolbar.",
  "homepage_url": "https://github.com/asisamko/window-focus-bypass",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Window Focus Bypass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["*://*/*"]
}
